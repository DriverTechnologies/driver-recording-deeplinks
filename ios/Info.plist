<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The scheme Driver opens to hand control back (RecordingDeepLink.sourceIdentifier). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.drivertechnologies.recordingsample</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>driver-recording-sample</string>
			</array>
		</dict>
	</array>
	<!-- Lets DriverInstallation ask canOpenURL whether Driver is installed. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>com.trydriver.driver</string>
	</array>
</dict>
</plist>
